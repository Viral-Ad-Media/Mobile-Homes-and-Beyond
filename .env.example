# Neon Postgres connection string (Neon console > your project > Connect).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`) and the site's public URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://mobilehomesandbeyond.com
NEXT_PUBLIC_SITE_URL=https://mobilehomesandbeyond.com

# The only email allowed to create the first admin account at /admin/setup.
ADMIN_EMAIL=
